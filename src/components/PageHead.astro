---
interface Crumb { label: string; href?: string }
interface Props { title: string; intro?: string; crumbs?: Crumb[] }
const { title, intro, crumbs = [] } = Astro.props;
const all = [{ label: 'Home', href: '/' }, ...crumbs];
---
<section class="page-head">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      {all.map((c, i) => (
        <>
          {i > 0 && <span aria-hidden="true">/</span>}
          {c.href && i < all.length - 1 ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
        </>
      ))}
    </nav>
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
    <slot />
  </div>
</section>
