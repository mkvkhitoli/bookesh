---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section">
    <div class="wrap" style="text-align:center;max-width:560px">
      <div style="font:700 5rem var(--font-head);color:var(--brand)">404</div>
      <h1 style="font-size:1.8rem">This page has moved or doesn't exist</h1>
      <p class="muted">The new Bookesh is organised differently. Try one of these:</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:20px">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/mp-board/" class="btn btn-ghost">MP Board</a>
        <a href="/mock-tests/" class="btn btn-ghost">Mock Tests</a>
      </div>
    </div>
  </section>
</Base>
